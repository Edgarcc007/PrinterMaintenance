<Page x:Class="PrinterMaintenanceUI.Views.MaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:PrinterMaintenanceUI.Converters"
      Background="#F5F5F5">

    <Page.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibility"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00695C" BorderBrush="#00695C"
                    Click="AddRecord_Click" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                    <TextBlock Text="New Record" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CmbType" Width="160"
                          materialDesign:HintAssist.Hint="Type"
                          materialDesign:HintAssist.IsFloating="False"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                    <ComboBoxItem Content="Preventive"/>
                    <ComboBoxItem Content="Corrective"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="TxtCount" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>

        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="0">
            <DataGrid x:Name="GridRecords" Style="{StaticResource StyledDataGrid}"
                      MouseDoubleClick="GridRecords_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Printer" Binding="{Binding PrinterDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="Auto"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                    <DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy}" Width="Auto"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding PerformedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMinutes, StringFormat={}{0} min}" Width="Auto"/>
                    <DataGridTemplateColumn Header="Status" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x2713; Complete"
                                        Click="CompleteRecord_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibility}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#00695C" FontSize="11" FontWeight="SemiBold"
                                        Padding="8,2" Height="28"
                                        ToolTip="Mark as Completed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>
