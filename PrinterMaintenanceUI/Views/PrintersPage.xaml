<Page x:Class="PrinterMaintenanceUI.Views.PrintersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:PrinterMaintenanceUI.Converters"
      Background="#F5F5F5">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00695C" BorderBrush="#00695C"
                    Click="AddPrinter_Click" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                    <TextBlock Text="Add Printer" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal">
                <!-- Search -->
                <TextBox x:Name="TxtSearch" Width="250"
                         materialDesign:HintAssist.Hint="Search printers..."
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,12,0" KeyDown="Search_KeyDown"/>

                <!-- Status filter -->
                <ComboBox x:Name="CmbStatus" Width="150"
                          materialDesign:HintAssist.Hint="Status"
                          materialDesign:HintAssist.IsFloating="False"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Status" IsSelected="True"/>
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="In Repair"/>
                    <ComboBoxItem Content="Decommissioned"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Count -->
        <TextBlock Grid.Row="1" x:Name="TxtCount" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>

        <!-- Printers DataGrid -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="0">
            <Grid>
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="36" Height="36"
                             x:Name="LoadingBar" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"/>

                <DataGrid x:Name="GridPrinters" Style="{StaticResource StyledDataGrid}"
                          MouseDoubleClick="EditPrinter_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="Auto"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="Asset Tag" Binding="{Binding AssetTag}" Width="Auto"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="Auto"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Status" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="10,3"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Status, Converter={StaticResource StatusToColor}, ConverterParameter=bg}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                Width="30" Height="30" Padding="0"
                                                ToolTip="Edit" Click="EditPrinter_Click"
                                                Tag="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"
                                                                      Foreground="#1565C0"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                Width="30" Height="30" Padding="0"
                                                ToolTip="Delete" Click="DeletePrinter_Click"
                                                Tag="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"
                                                                      Foreground="#C62828"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
