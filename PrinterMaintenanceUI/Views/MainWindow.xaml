<Window x:Class="PrinterMaintenanceUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Printer Maintenance Control"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37474F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#00695C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#263238">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="16,20" Background="#1B262C">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Printer" Width="28" Height="28" 
                                                      Foreground="#4DB6AC" VerticalAlignment="Center"/>
                            <TextBlock Text="Printer" FontSize="20" FontWeight="Bold" 
                                       Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Maintenance Control" FontSize="12" 
                                   Foreground="#4DB6AC" Margin="38,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- User info at bottom -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" Background="#1B262C">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" 
                                                  Foreground="#4DB6AC"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="IT Engineering" FontSize="11" Foreground="#B0BEC5"/>
                            <TextBlock Text="Moka Technology" FontSize="10" Foreground="#607D8B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="MAIN" FontSize="10" Foreground="#607D8B" 
                                   Margin="16,8,0,8" FontWeight="SemiBold"/>

                        <Button x:Name="BtnDashboard" Click="Navigate_Click" Tag="Dashboard"
                                Style="{StaticResource SidebarButtonActive}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPrinters" Click="Navigate_Click" Tag="Printers"
                                Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Printers" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="MAINTENANCE" FontSize="10" Foreground="#607D8B" 
                                   Margin="16,16,0,8" FontWeight="SemiBold"/>

                        <Button x:Name="BtnMaintenance" Click="Navigate_Click" Tag="Maintenance"
                                Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wrench" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Records" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSchedule" Click="Navigate_Click" Tag="Schedule"
                                Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Schedule" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SETTINGS" FontSize="10" Foreground="#607D8B" 
                                   Margin="16,16,0,8" FontWeight="SemiBold"/>

                        <Button x:Name="BtnLocations" Click="Navigate_Click" Tag="Locations"
                                Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerOutline" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Locations" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCategories" Click="Navigate_Click" Tag="Categories"
                                Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TagMultipleOutline" Width="20" Height="20" 
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Categories" Margin="12,0,0,0" FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- CONTENT AREA -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <DockPanel>
                <!-- Top Bar -->
                <materialDesign:Card DockPanel.Dock="Top" Padding="20,12" 
                                      materialDesign:ElevationAssist.Elevation="Dp1"
                                      UniformCornerRadius="0">
                    <DockPanel>
                        <TextBlock x:Name="TxtPageTitle" Text="Dashboard" 
                                   FontSize="18" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Refresh" Click="Refresh_Click">
                                <materialDesign:PackIcon Kind="Refresh"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Page Content -->
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" 
                       Margin="0" Background="Transparent"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

