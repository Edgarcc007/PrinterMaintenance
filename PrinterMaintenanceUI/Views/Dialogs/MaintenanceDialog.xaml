<Window x:Class="PrinterMaintenanceUI.Views.Dialogs.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Maintenance Record" Height="620" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="New Maintenance Record" FontSize="20" FontWeight="Medium"
                   Margin="0,0,0,20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ComboBox x:Name="CmbPrinter" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Printer *"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

                <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Category *"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

                <ComboBox x:Name="CmbType"
                          materialDesign:HintAssist.Hint="Type *"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                    <ComboBoxItem Content="Preventive" IsSelected="True"/>
                    <ComboBoxItem Content="Corrective"/>
                </ComboBox>

                <TextBox x:Name="TxtPerformedBy"
                         materialDesign:HintAssist.Hint="Performed By *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

                <TextBox x:Name="TxtDuration"
                         materialDesign:HintAssist.Hint="Duration (minutes)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

                <ComboBox x:Name="CmbStatus"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                    <ComboBoxItem Content="Completed" IsSelected="True"/>
                    <ComboBoxItem Content="In Progress"/>
                    <ComboBoxItem Content="Pending"/>
                </ComboBox>

                <TextBox x:Name="TxtFindings"
                         materialDesign:HintAssist.Hint="Findings"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" Margin="0,0,0,12"/>

                <TextBox x:Name="TxtActions"
                         materialDesign:HintAssist.Hint="Actions Taken"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" Margin="0,0,0,12"/>

                <TextBox x:Name="TxtParts"
                         materialDesign:HintAssist.Hint="Parts Replaced"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Save" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00695C" BorderBrush="#00695C"/>
        </StackPanel>
    </Grid>
</Window>
