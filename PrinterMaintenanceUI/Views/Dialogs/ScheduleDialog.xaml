<Window x:Class="PrinterMaintenanceUI.Views.Dialogs.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="New Schedule" Height="380" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Maintenance Schedule" FontSize="20" FontWeight="Medium"
                   Margin="0,0,0,20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

        <StackPanel Grid.Row="1">
            <ComboBox x:Name="CmbPrinter" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      materialDesign:HintAssist.Hint="Printer *"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

            <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id"
                      materialDesign:HintAssist.Hint="Preventive Task *"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

            <TextBox x:Name="TxtFrequency"
                     materialDesign:HintAssist.Hint="Frequency (days) *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <DatePicker x:Name="DpNextDue"
                        materialDesign:HintAssist.Hint="Next Due Date *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00695C" BorderBrush="#00695C"/>
        </StackPanel>
    </Grid>
</Window>
