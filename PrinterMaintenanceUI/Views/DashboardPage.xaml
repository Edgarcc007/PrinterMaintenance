<Page x:Class="PrinterMaintenanceUI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:PrinterMaintenanceUI.Converters"
      Background="#F5F5F5">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:DaysToColorConverter x:Key="DaysToColor"/>
    </Page.Resources>

    <Grid>
        <!-- Loading overlay -->
        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                     IsIndeterminate="True" Width="40" Height="40"
                     Visibility="{Binding IsLoading, ElementName=ThisPage, Converter={StaticResource BoolToVis}}"
                     Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"
                      Visibility="{Binding IsLoading, ElementName=ThisPage, Converter={StaticResource InvBoolToVis}}">
            <StackPanel>

                <!-- KPI Cards Row 1 -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <!-- Total Printers -->
                    <materialDesign:Card Margin="0,0,12,0" Padding="20" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#E0F2F1" CornerRadius="8"
                                    Width="48" Height="48" Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="Printer" Width="24" Height="24"
                                                          Foreground="#00695C"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Printers" FontSize="12" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtTotalPrinters" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#263238"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Active -->
                    <materialDesign:Card Margin="6,0,6,0" Padding="20" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#E8F5E9" CornerRadius="8"
                                    Width="48" Height="48" Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="24" Height="24"
                                                          Foreground="#2E7D32"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Active" FontSize="12" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtActive" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#2E7D32"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- In Repair -->
                    <materialDesign:Card Margin="6,0,6,0" Padding="20" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FFF3E0" CornerRadius="8"
                                    Width="48" Height="48" Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="Wrench" Width="24" Height="24"
                                                          Foreground="#F57C00"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="In Repair" FontSize="12" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtInRepair" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#F57C00"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Overdue -->
                    <materialDesign:Card Margin="12,0,0,0" Padding="20" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FFEBEE" CornerRadius="8"
                                    Width="48" Height="48" Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24"
                                                          Foreground="#C62828"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Overdue" FontSize="12" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtOverdue" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#C62828"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- KPI Cards Row 2 -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <!-- Upcoming 7 days -->
                    <materialDesign:Card Margin="0,0,8,0" Padding="16" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#E3F2FD" CornerRadius="8"
                                    Width="40" Height="40" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="CalendarAlert" Width="20" Height="20"
                                                          Foreground="#1565C0"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Due in 7 days" FontSize="11" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtUpcoming" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="#1565C0"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Completed this month -->
                    <materialDesign:Card Margin="4,0,4,0" Padding="16" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#E8F5E9" CornerRadius="8"
                                    Width="40" Height="40" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="CheckAll" Width="20" Height="20"
                                                          Foreground="#2E7D32"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Completed (month)" FontSize="11" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtCompleted" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="#2E7D32"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Corrective this month -->
                    <materialDesign:Card Margin="8,0,0,0" Padding="16" UniformCornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FFF3E0" CornerRadius="8"
                                    Width="40" Height="40" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                                          Foreground="#E65100"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Corrective (month)" FontSize="11" Foreground="#9E9E9E"/>
                                <TextBlock x:Name="TxtCorrective" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="#E65100"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- Overdue Table -->
                <materialDesign:Card Padding="20" UniformCornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828"
                                                      Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Overdue Maintenance" FontSize="16" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOverdueCount" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12" Foreground="#9E9E9E"/>
                        </DockPanel>

                        <!-- Empty state -->
                        <TextBlock x:Name="TxtNoOverdue" Text="No overdue maintenance tasks"
                                   Foreground="#9E9E9E" FontSize="13" Margin="0,8,0,8"
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>

                        <DataGrid x:Name="GridOverdue"
                                  Style="{StaticResource StyledDataGrid}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Printer" Binding="{Binding PrinterDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="Auto"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="Auto"/>
                                <DataGridTextColumn Header="Task" Binding="{Binding MaintenanceTask}" Width="*"/>
                                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                                <DataGridTemplateColumn Header="Days Overdue" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFEBEE" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding DaysOverdue, StringFormat={}{0}d}"
                                                           Foreground="#C62828" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Connection status -->
                <materialDesign:Card x:Name="CardError" Padding="12" UniformCornerRadius="8"
                                      Visibility="Collapsed" Background="#FFEBEE">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ServerNetworkOff" Foreground="#C62828"
                                                  Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtError" Margin="8,0,0,0" Foreground="#C62828"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
