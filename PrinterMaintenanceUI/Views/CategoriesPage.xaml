<Page x:Class="PrinterMaintenanceUI.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="20" UniformCornerRadius="8" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Add Category" FontSize="16" FontWeight="Medium" Margin="0,0,0,12"/>
                <WrapPanel>
                    <TextBox x:Name="TxtName" Width="200"
                             materialDesign:HintAssist.Hint="Category Name *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,12,0"/>
                    <ComboBox x:Name="CmbType" Width="160"
                              materialDesign:HintAssist.Hint="Type *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,12,0">
                        <ComboBoxItem Content="Preventive" IsSelected="True"/>
                        <ComboBoxItem Content="Corrective"/>
                    </ComboBox>
                    <TextBox x:Name="TxtFreq" Width="120"
                             materialDesign:HintAssist.Hint="Freq. (days)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,12,0"/>
                    <TextBox x:Name="TxtDesc" Width="250"
                             materialDesign:HintAssist.Hint="Description"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,12,0"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00695C" BorderBrush="#00695C"
                            Click="Add_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="0">
            <DataGrid x:Name="GridCategories" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                    <DataGridTextColumn Header="Frequency (days)" Binding="{Binding FrequencyDays}" Width="Auto"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>
