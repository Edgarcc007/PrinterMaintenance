<Page x:Class="PrinterMaintenanceUI.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:PrinterMaintenanceUI.Converters"
      Background="#F5F5F5">

    <Page.Resources>
        <converters:DaysToColorConverter x:Key="DaysToColor"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00695C" BorderBrush="#00695C"
                    Click="AddSchedule_Click" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                    <TextBlock Text="New Schedule" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TxtCount" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Schedule grid -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="0">
            <DataGrid x:Name="GridSchedules" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Printer" Binding="{Binding PrinterDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationDisplay}" Width="Auto"/>
                    <DataGridTextColumn Header="Task" Binding="{Binding CategoryDisplay}" Width="Auto"/>
                    <DataGridTextColumn Header="Every (days)" Binding="{Binding FrequencyDays}" Width="Auto"/>
                    <DataGridTextColumn Header="Last Done" Binding="{Binding LastPerformed, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                    <DataGridTextColumn Header="Next Due" Binding="{Binding NextDueDate, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                    <DataGridTemplateColumn Header="Days Left" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DaysRemaining}" FontWeight="SemiBold"
                                           Foreground="{Binding DaysRemaining, Converter={StaticResource DaysToColor}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>
